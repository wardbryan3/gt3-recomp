diff --git a/tests/gt3_core_test.py b/tests/gt3_core_test.py
new file mode 100644
index 0000000..8c06728
--- /dev/null
+++ b/tests/gt3_core_test.py
@@ -0,0 +1,109 @@
+"""Game-free CORE wrapper/conversion and port-script selection regressions."""
+import importlib.util
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+import zlib
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location('core', ROOT / 'scripts/gt4_core.py')
+CORE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(CORE)
+
+
+class CoreTests(unittest.TestCase):
+    def test_gt3_and_gt4_synthetic_containers(self):
+        # Metadata and payloads are invented; no game executable is embedded.
+        parts = [(0x10000, b'synthetic-first'), (0x12000, b'synthetic-second')]
+        image = b''
+        for name in (b'synthetic', b'fixture'):
+            image += struct.pack('<H', len(name)) + name
+        image += struct.pack('<iI', len(parts), 0x10000)
+        for address, data in parts:
+            image += struct.pack('<II', address, len(data)) + data
+        compressor = zlib.compressobj(wbits=-15)
+        packed = struct.pack('<HI', 0, len(image)) + compressor.compress(image) + compressor.flush()
+        self.assertEqual(CORE.sections(CORE.unpack(packed)), (0x10000, parts))
+        for name in ('CORE.GT3', 'CORE.GT4'):
+            with self.subTest(name=name), tempfile.TemporaryDirectory() as tmp:
+                src, out = Path(tmp) / name, Path(tmp) / 'synthetic.elf'
+                src.write_bytes(packed)
+                subprocess.run([sys.executable, '-I', str(ROOT / 'scripts/gt4_core.py'), str(src), str(out)],
+                               check=True, capture_output=True, text=True)
+                elf = out.read_bytes()
+                self.assertEqual(elf[:7], b'\x7fELF\x01\x01\x01')
+                self.assertEqual(struct.unpack_from('<I', elf, 24)[0], 0x10000)
+                self.assertEqual(struct.unpack_from('<I', elf, 36)[0], CORE.R5900_FLAGS)
+                self.assertEqual(struct.unpack_from('<H', elf, 44)[0], len(parts))
+                for i, (address, data) in enumerate(parts):
+                    header = struct.unpack_from('<8I', elf, 52 + i * 32)
+                    self.assertEqual(header[0], 1)
+                    self.assertEqual(header[2:6], (address, address, len(data), len(data)))
+                    self.assertEqual(elf[header[1]:header[1] + header[4]], data)
+
+    def selection(self, listing, cached=False):
+        # Exercise the actual executable-selection block, not a copy of its awk.
+        script = (ROOT / 'scripts/port.sh').read_text()
+        stage = script.split('echo "== [2/6] executable"', 1)[1].split('echo "${elf#$ROOT/}"', 1)[0]
+        with tempfile.TemporaryDirectory() as tmp:
+            game = Path(tmp) / 'game'
+            (game / 'disc').mkdir(parents=True)
+            if cached:
+                (game / 'core.elf').write_bytes(b'synthetic-cache')
+            listing_file = Path(tmp) / 'listing'
+            listing_file.write_text(listing)
+            calls = Path(tmp) / 'calls'
+            env = dict(os.environ, ROOT=str(ROOT), here=str(ROOT / 'scripts'), game=str(game),
+                       iso='unused-synthetic.iso', program='BOOT.ELF', LISTING_FILE=str(listing_file), CALLS=str(calls))
+            mock = r'''
+python3() {
+  printf '%s\n' "$*" >> "$CALLS"
+  if [[ "$2" == "$here/disc.py" ]]; then
+    if [[ "$3" == list ]]; then
+      while IFS= read -r line; do printf '%s\n' "$line"; done < "$LISTING_FILE"
+    elif [[ "$3" == extract ]]; then
+      touch "$5/$6"
+    else return 1; fi
+  elif [[ "$2" == "$here/gt4_core.py" ]]; then
+    touch "$4"
+  else return 1; fi
+}
+'''
+            result = subprocess.run(['bash', '-euo', 'pipefail', '-c', mock + stage + '\nprintf "%s\\n" "$elf"'],
+                                    env=env, text=True, capture_output=True, check=True)
+            return Path(result.stdout.strip()).name, calls.read_text() if calls.exists() else ''
+
+    def test_gt3_selection(self):
+        selected, calls = self.selection('1 2 3 CORE.GT3\n')
+        self.assertEqual(selected, 'core.elf')
+        self.assertIn('extract', calls)
+        self.assertIn('CORE.GT3', calls)
+
+    def test_gt4_selection(self):
+        selected, calls = self.selection('1 2 3 CORE.GT4\n')
+        self.assertEqual(selected, 'core.elf')
+        self.assertIn('CORE.GT4', calls)
+
+    def test_normal_boot_fallback(self):
+        selected, calls = self.selection('1 2 3 OTHER.DAT\n')
+        self.assertEqual(selected, 'BOOT.ELF')
+        self.assertNotIn('extract', calls)
+
+    def test_cached_core_precedence(self):
+        selected, calls = self.selection('1 2 3 CORE.GT3\n', cached=True)
+        self.assertEqual(selected, 'core.elf')
+        self.assertEqual(calls, '')
+
+    def test_selection_consumes_long_listing(self):
+        # Early awk exit would SIGPIPE a long producer under set -o pipefail.
+        selected, _ = self.selection('1 2 3 CORE.GT3\n' + '1 2 3 SYNTHETIC.DAT\n' * 10000)
+        self.assertEqual(selected, 'core.elf')
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/gt3_initialization_test.cpp b/tests/gt3_initialization_test.cpp
new file mode 100644
index 0000000..b6659ef
--- /dev/null
+++ b/tests/gt3_initialization_test.cpp
@@ -0,0 +1,86 @@
+#include "hw.hpp"
+#include "iop/hw.hpp"
+#include "ps2/state.hpp"
+
+#include <cstdint>
+#include <cstdio>
+
+namespace {
+int failures = 0;
+void check(bool ok, const char *message) {
+    if (!ok) { std::fprintf(stderr, "FAIL: %s\n", message); ++failures; }
+}
+
+void interrupt_latch() {
+    using namespace ps2;
+    hw::reset();
+    hw::intc_set_mask(2, true);
+    hw::intc_set_mask(3, true);
+    hw::intc_raise(2);
+    check(hw::intc_pending() == 4, "vblank is pending");
+    hw::intc_ack(2);
+    check(hw::intc_pending() == 0, "delivered interrupt is not repeatedly dispatched");
+    check(hw::read32(0x1000F000) == 4, "guest can still poll the delivered interrupt");
+    hw::intc_raise(3);
+    state::Writer saved;
+    hw::state(saved);
+    saved.tag("done");
+    hw::reset();
+    state::Reader restored(saved.out.data(), saved.out.size());
+    hw::state(restored);
+    restored.tag("done");
+    check(hw::read32(0x1000F000) == 12, "snapshot retains delivered and pending interrupt latches");
+    check(hw::intc_pending() == 8, "restoring a delivered latch does not redeliver its handler");
+    hw::write32(0x1000F000, 4);
+    check(hw::read32(0x1000F000) == 8, "write-one-to-clear preserves unrelated status");
+    check(hw::intc_pending() == 8, "write-one-to-clear preserves unrelated pending delivery");
+    hw::intc_raise(2);
+    check(hw::intc_pending() == 12, "a new vblank can be delivered again");
+}
+
+void ilink_initialization() {
+    using namespace ps2;
+    iop::hw::reset();
+    check(iop::hw::read(0x1F808400, 4) == 0xFFC00001, "local i.Link identification stub");
+    check(iop::hw::read(0x1F80847C, 4) == 0x10000001, "local i.Link capability stub");
+    iop::hw::write(0x1F808410, 2, 4);
+    check((iop::hw::read(0x1F808410, 4) & 10) == 10, "link initialization reports serial clock ready");
+    iop::hw::write(0x1F808408, 0x00800000, 4);
+    check((iop::hw::read(0x1F808408, 4) & 0x00800000) == 0, "local initialization request completes");
+    iop::hw::write(0x1F808414, 0x400004A5, 4);
+    check((iop::hw::read(0x1F808414, 4) & 0x40000000) == 0, "PHY write completes");
+    iop::hw::write(0x1F808414, 0x84000000, 4);
+    check((iop::hw::read(0x1F808414, 4) & 0x8000FFFF) == 0x04A5, "PHY read completes and returns its register");
+    iop::hw::set_interrupt_mask(24, true);
+    check(iop::hw::next_pending_interrupt() != 24, "masked PHY completion does not raise the device IRQ");
+    iop::hw::write(0x1F808424, 0x40000000, 4);
+    iop::hw::write(0x1F808414, 0x84000000, 4);
+    check(iop::hw::next_pending_interrupt() == 24, "enabled PHY completion raises i.Link IRQ");
+    check((iop::hw::read(0x1F808420, 4) & 0x40000000) != 0, "PHY completion sets status");
+    iop::hw::write(0x1F808420, 0x40000000, 4);
+    check(iop::hw::read(0x1F808420, 4) == 0, "PHY status is write-one-to-clear");
+    iop::hw::write(0x1F808414, 0x4000053C, 4);
+    state::Writer saved;
+    iop::hw::state(saved);
+    saved.tag("done");
+    iop::hw::reset();
+    state::Reader restored(saved.out.data(), saved.out.size());
+    iop::hw::state(restored);
+    restored.tag("done");
+    iop::hw::write(0x1F808414, 0x84000000, 4);
+    check((iop::hw::read(0x1F808414, 4) & 0xFFFF) == 0x04A5, "snapshot restores PHY register 4");
+    iop::hw::write(0x1F808414, 0x85000000, 4);
+    check((iop::hw::read(0x1F808414, 4) & 0xFFFF) == 0x053C, "snapshot restores a distinct PHY register");
+    iop::hw::reset();
+    iop::hw::write(0x1F808414, 0x84000000, 4);
+    check((iop::hw::read(0x1F808414, 4) & 0xFF) == 0, "reset clears PHY register storage");
+}
+}
+
+int main() {
+    interrupt_latch();
+    ilink_initialization();
+    if (failures) return 1;
+    std::puts("GT3 initialization regression PASS");
+    return 0;
+}
diff --git a/tests/gt3_state_test.cpp b/tests/gt3_state_test.cpp
new file mode 100644
index 0000000..3a4b4f7
--- /dev/null
+++ b/tests/gt3_state_test.cpp
@@ -0,0 +1,65 @@
+#include "hw.hpp"
+#include "iop/hw.hpp"
+#include "iop/iop.hpp"
+#include "kernel.hpp"
+#include "ps2/memory.hpp"
+#include "ps2/system.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <vector>
+
+int main() {
+    using namespace ps2;
+    const auto dir = std::filesystem::temp_directory_path() /
+        ("ps2-state-test-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    if (!std::filesystem::create_directory(dir)) return 1;
+    struct Cleanup {
+        std::filesystem::path path;
+        ~Cleanup() { std::error_code ec; std::filesystem::remove_all(path, ec); }
+    } cleanup{dir};
+    int failures = 0;
+    const auto check = [&](bool ok, const char *message) {
+        if (!ok) { std::fprintf(stderr, "FAIL: %s\n", message); ++failures; }
+    };
+    hw::reset();
+    iop::reset();
+    kernel::reset();
+    kernel::start_main_thread(0x10000, 0, 0, 0);
+    hw::intc_set_mask(2, true);
+    hw::intc_raise(2);
+    hw::intc_ack(2);
+    iop::hw::write(0x1F808414, 0x400004A5, 4);
+    const auto path = (dir / "synthetic.state").string();
+    if (!save_state(path)) return 1;
+    std::ifstream input(path, std::ios::binary);
+    std::vector<std::uint8_t> bytes{std::istreambuf_iterator<char>(input), {}};
+    if (bytes.size() < 12) return 1;
+    std::uint32_t version;
+    std::memcpy(&version, bytes.data() + 8, sizeof version);
+    check(version == 3, "new snapshot layout uses version 3");
+    hw::reset();
+    iop::hw::reset();
+    g_cpu.pc = 0x20000;
+    check(load_state(bytes.data(), bytes.size()), "new snapshot loads successfully");
+    check(g_cpu.pc == 0x10000, "snapshot restores the CPU");
+    check((hw::read32(0x1000F000) & 4) != 0, "snapshot restores the guest-visible delivered latch");
+    check(hw::intc_pending() == 0, "snapshot does not redeliver that interrupt");
+    iop::hw::write(0x1F808414, 0x84000000, 4);
+    check((iop::hw::read(0x1F808414, 4) & 0xFFFF) == 0x04A5, "snapshot restores the PHY register");
+    // Test the version gate, not a migration: no old-layout body is embedded.
+    version = 2;
+    std::memcpy(bytes.data() + 8, &version, sizeof version);
+    g_cpu.pc = 0x30000;
+    st32(0x9000, 0x12345678);
+    check(!load_state(bytes.data(), bytes.size()), "old version is explicitly rejected");
+    check(g_cpu.pc == 0x30000 && ld32(0x9000) == 0x12345678,
+          "version rejection happens before CPU or RAM mutation");
+    if (failures) return 1;
+    std::puts("GT3 snapshot schema regression PASS");
+    return 0;
+}
diff --git a/tests/kernel_exit_delete_thread_test.cpp b/tests/kernel_exit_delete_thread_test.cpp
new file mode 100644
index 0000000..95e3312
--- /dev/null
+++ b/tests/kernel_exit_delete_thread_test.cpp
@@ -0,0 +1,96 @@
+#include "kernel.hpp"
+#include "ps2/generated.hpp"
+#include "ps2/memory.hpp"
+#include "ps2/system.hpp"
+
+#include <cstdint>
+#include <cstdio>
+
+namespace {
+constexpr std::uint32_t kMainEntry = 0x10000;
+constexpr std::uint32_t kWorkerEntry = 0x12000;
+int failures = 0;
+
+void check(bool ok, const char *message) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", message);
+        ++failures;
+    }
+}
+
+void start() {
+    ps2::kernel::reset();
+    ps2::kernel::start_main_thread(kMainEntry, 0, 0, 0);
+    ps2::g_cpu.pc = kMainEntry + 4;
+}
+
+void syscall(std::uint32_t number) {
+    ps2::g_cpu.r[3].w[0] = number;
+    ps2::kernel::handle_syscall(ps2::g_cpu, kMainEntry);
+}
+
+void check_idle(const char *message) {
+    check(ps2::kernel::current_thread() == 0, "no thread is running after the last runnable thread exits");
+    check((ps2::g_cpu.pc & ~ps2::kUnwind) == ps2::kIdle, message);
+    check((ps2::g_cpu.pc & ps2::kUnwind) != 0, "idle transition requests unwind of the translated call stack");
+    ps2::kernel::service(ps2::g_cpu);
+    check(ps2::g_cpu.pc == ps2::kIdle, "kernel service clears unwind and remains idle with no ready thread");
+}
+
+int create_worker() {
+    constexpr std::uint32_t descriptor = 0x3000;
+    for (unsigned i = 0; i < 36; i += 4) ps2::st32(descriptor + i, 0);
+    ps2::st32(descriptor + 4, kWorkerEntry);
+    ps2::st32(descriptor + 8, 0x20000);
+    ps2::st32(descriptor + 12, 0x1000);
+    ps2::st32(descriptor + 20, 16); // Lower priority than the main thread (0).
+    ps2::g_cpu.r[4].w[0] = descriptor;
+    syscall(0x20); // CreateThread
+    const int id = static_cast<int>(ps2::g_cpu.r[2].w[0]);
+    check(id > 1, "a dormant worker thread is created");
+    return id;
+}
+
+void exit_without_delete() {
+    start();
+    syscall(0x23); // ExitThread: current thread remains in the table, dormant.
+    check_idle("ExitThread of the only runnable thread enters idle");
+}
+
+void delete_last_thread() {
+    start();
+    syscall(0x24); // ExitDeleteThread: both current() and best_ready() become null.
+    check_idle("ExitDeleteThread enters idle instead of continuing deleted guest code");
+}
+
+void delete_with_dormant_worker() {
+    start();
+    create_worker();
+    syscall(0x24);
+    check_idle("a dormant thread must not prevent ExitDeleteThread from entering idle");
+}
+
+void delete_with_ready_worker() {
+    start();
+    const int id = create_worker();
+    ps2::g_cpu.r[4].w[0] = static_cast<std::uint32_t>(id);
+    ps2::g_cpu.r[5].w[0] = 0x1234;
+    syscall(0x22); // StartThread: ready, but it should not preempt main's priority.
+    check(ps2::kernel::current_thread() == 1, "starting a lower-priority worker keeps the main thread running");
+    syscall(0x24);
+    check(ps2::kernel::current_thread() == id, "deleting main schedules the ready worker");
+    check((ps2::g_cpu.pc & ~ps2::kUnwind) == kWorkerEntry, "ready worker's entry PC is restored");
+    check((ps2::g_cpu.pc & ps2::kUnwind) != 0, "switching to the worker requests unwind");
+    check(ps2::g_cpu.r[4].w[0] == 0x1234, "ready worker's argument is restored");
+}
+}
+
+int main() {
+    exit_without_delete();
+    delete_last_thread();
+    delete_with_dormant_worker();
+    delete_with_ready_worker();
+    if (failures) return 1;
+    std::puts("ExitDeleteThread idle regression PASS");
+    return 0;
+}
diff --git a/tests/sif_scratchpad_test.cpp b/tests/sif_scratchpad_test.cpp
new file mode 100644
index 0000000..a61bca9
--- /dev/null
+++ b/tests/sif_scratchpad_test.cpp
@@ -0,0 +1,74 @@
+#include "iop/iop.hpp"
+#include "iop/sif.hpp"
+#include "ps2/memory.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <initializer_list>
+
+namespace {
+int failures = 0;
+
+void check(bool ok, const char *message) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", message);
+        ++failures;
+    }
+}
+
+void descriptor(std::uint32_t at, std::uint32_t source, std::uint32_t dest, std::uint32_t size) {
+    ps2::st32(at, source);
+    ps2::st32(at + 4, dest);
+    ps2::st32(at + 8, size);
+    ps2::st32(at + 12, 0);
+}
+
+void payload(std::uint32_t at, unsigned size, std::uint8_t first) {
+    for (unsigned i = 0; i < size; ++i) ps2::st8(at + i, static_cast<std::uint8_t>(first + i));
+}
+
+bool copied(std::uint32_t at, unsigned size, std::uint8_t first) {
+    for (unsigned i = 0; i < size; ++i)
+        if (ps2::iop::read8(at + i) != static_cast<std::uint8_t>(first + i)) return false;
+    return true;
+}
+
+void ram_descriptors() {
+    // All these EE addresses resolve to the same main-RAM descriptor.
+    for (const std::uint32_t address : {0x00001000u, 0x80001000u, 0xA0001000u, 0x20001000u, 0x30001000u}) {
+        ps2::sif::reset();
+        descriptor(0x1000, 0x2000, 0x8000, 16);
+        payload(0x2000, 16, 0x40);
+        for (unsigned i = 0; i < 16; ++i) ps2::iop::write8(0x8000 + i, 0);
+        check(ps2::sif::set_dma(address, 1) != 0, "RAM descriptor returns a DMA ID");
+        check(copied(0x8000, 16, 0x40), "main-RAM descriptor and its aliases copy the expected payload");
+    }
+}
+
+void scratchpad_descriptors() {
+    ps2::sif::reset();
+    constexpr std::uint32_t list = ps2::kScratchpadBase + 0x1000;
+    descriptor(list, 0x2000, 0x8000, 16);
+    descriptor(list + 16, 0x2100, 0x8010, 12);
+    payload(0x2000, 16, 0xA0);
+    payload(0x2100, 12, 0xC0);
+    payload(0x2200, 16, 0x10);
+    // Conflicting, valid descriptors at the addresses obtained by masking the
+    // scratchpad list into RAM. The old reader will copy these instead.
+    descriptor(0x1000, 0x2200, 0x8000, 16);
+    descriptor(0x1010, 0x2200, 0x8010, 12);
+    for (unsigned i = 0; i < 32; ++i) ps2::iop::write8(0x8000 + i, 0xEE);
+    check(ps2::sif::set_dma(list, 2) != 0, "scratchpad descriptor list returns a DMA ID");
+    check(copied(0x8000, 16, 0xA0), "first descriptor is read from scratchpad, not its RAM alias");
+    check(copied(0x8010, 12, 0xC0), "second descriptor is read from scratchpad, not its RAM alias");
+    check(ps2::iop::read8(0x801C) == 0xEE, "bytes beyond the requested transfers remain untouched");
+}
+}
+
+int main() {
+    ram_descriptors();
+    scratchpad_descriptors();
+    if (failures) return 1;
+    std::puts("SIF scratchpad descriptor regression PASS");
+    return 0;
+}
