+#include "../runtime/src/gs/queue.hpp"
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+
+int main() {
+    using namespace ps2::gs::queue;
+    for (unsigned phase = 0; phase < 4; ++phase) {
+        Ring ring;
+        ring.start(256u << phase);
+        constexpr unsigned count = 250000;
+        std::thread producer([&] {
+            for (unsigned i = 0; i < count; ++i) {
+                std::array<unsigned, 12> values;
+                values.fill(i ^ 0xdeadbeef);
+                ring.post(kGif, i, ~i, values.data(), (1 + i % 12) * 4);
+                if (!(i % 997)) std::this_thread::sleep_for(std::chrono::microseconds(10));
+            }
+        });
+        for (unsigned i = 0; i < count; ++i) {
+            Header h;
+            const std::uint8_t *payload;
+            while (!ring.peek(h, payload)) ring.wait_for_work(1);
+            if (h.type != kGif || h.arg0 != i || h.arg1 != ~i || h.bytes != (1 + i % 12) * 4) std::abort();
+            for (unsigned k = 0; k < h.bytes / 4; ++k) {
+                unsigned v; std::memcpy(&v, payload + 4 * k, 4);
+                if (v != (i ^ 0xdeadbeef)) std::abort();
+            }
+            if (!(i % 991)) std::this_thread::sleep_for(std::chrono::microseconds(10));
+            ring.pop(h);
+        }
+        producer.join();
+    }
+    std::puts("Queue ordering, wraparound, pressure and wakeups PASS: 1000000 records");
+}
