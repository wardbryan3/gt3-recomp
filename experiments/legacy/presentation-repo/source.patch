diff --git a/host/benchmark.hpp b/host/benchmark.hpp
new file mode 100644
index 0000000..cfe9db3
--- /dev/null
+++ b/host/benchmark.hpp
@@ -0,0 +1,83 @@
+#pragma once
+// Isolated, unpaced headless comparison of the existing native queue paths.
+// No display readback in the timed interval; identical full-detail raster work.
+#include "ps2/system.hpp"
+#include "../runtime/src/gs/gs.hpp"
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <functional>
+#include <thread>
+#include <vector>
+
+namespace experiment {
+inline unsigned warmup = 300, measured = 600;
+inline const char *capture = nullptr;
+inline int run(const std::function<int()> &emulate, unsigned workers) {
+    unsigned completed = 0;
+    std::chrono::steady_clock::time_point start;
+    const auto boundary = [&] {
+        ++completed;
+        if (completed == warmup || completed == warmup + measured) {
+            // Always called on the GPU owner, never on a parallel EE thread.
+            ps2::gs::flush_and_wait();
+            const auto now = std::chrono::steady_clock::now();
+            if (completed == warmup) start = now;
+            else std::fprintf(stderr, "[benchmark] workers=%u frames=%u warmup=%u ms/frame=%.4f\n",
+                workers, measured, warmup,
+                std::chrono::duration<double, std::milli>(now - start).count() / measured);
+        }
+    };
+    ps2::init_graphics();
+    int result = 0;
+    if (!workers) {
+        ps2::g_options.on_vblank = boundary;
+        result = emulate();
+    } else {
+        ps2::start_render_thread();
+        if (workers == 2) {
+            ps2::start_vu_thread();
+            std::thread(ps2::run_vu_thread).detach();
+        }
+        std::atomic<unsigned> posted{0};
+        ps2::g_options.on_vblank = [&] { ps2::post_present(); posted.fetch_add(1); };
+        std::atomic<bool> done{false};
+        std::thread ee([&] {
+            result = emulate();
+            // Ordered through VU then render: drain every final graphics packet.
+            // An empty render ring alone is not evidence that the VU ring is empty.
+            ps2::post_present();
+            posted.fetch_add(1);
+            done.store(true);
+            ps2::wake_render_thread();
+        });
+        for (;;) {
+            const auto rendered = ps2::render_pending(false, {}, boundary, 8.0);
+            if (rendered == ps2::Rendered::idle) {
+                if (done.load() && completed == posted.load()) break;
+                ps2::wait_render_work(4);
+            }
+        }
+        ee.join();
+    }
+    ps2::gs::flush_and_wait();
+    if (capture) {
+        std::vector<std::uint32_t> pixels;
+        std::uint32_t w = 0, h = 0;
+        if (!ps2::display_frame(pixels, w, h)) result = 1;
+        else if (auto *f = std::fopen(capture, "wb")) {
+            std::fprintf(f, "P6\n%u %u\n255\n", w, h);
+            for (auto p : pixels) {
+                const unsigned char rgb[3] = {static_cast<unsigned char>(p), static_cast<unsigned char>(p >> 8), static_cast<unsigned char>(p >> 16)};
+                std::fwrite(rgb, 1, 3, f);
+            }
+            if (std::fclose(f)) result = 1;
+        } else result = 1;
+    }
+    std::fprintf(stderr, "[benchmark] completed=%u drain_present=%u result=%d\n", completed - (workers ? 1 : 0), workers ? 1 : 0, result);
+    std::fflush(nullptr);
+    if (workers) std::_Exit(result); // Existing detached VU worker has no shutdown protocol.
+    return result;
+}
+}
diff --git a/host/presentation_probe.cpp b/host/presentation_probe.cpp
new file mode 100644
index 0000000..e51e464
--- /dev/null
+++ b/host/presentation_probe.cpp
@@ -0,0 +1,101 @@
+#include "presentation_probe.hpp"
+#include "ps2/system.hpp"
+#include "presentation-time-client-protocol.h"
+#include <SDL_syswm.h>
+#include <wayland-client.h>
+#include <poll.h>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <time.h>
+
+namespace probe {
+namespace {
+std::uint64_t ns() { timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return std::uint64_t(t.tv_sec)*1000000000+t.tv_nsec; }
+struct Frame { unsigned id, w, h, queued; std::uint64_t begin, end=0, displayed=0, sequence=0, audio=0; unsigned refresh=0, flags=0, status=0; };
+std::deque<Frame> frames;
+wl_display *display=nullptr;
+wl_surface *surface=nullptr;
+wl_event_queue *queue=nullptr;
+wl_registry *registry=nullptr;
+wp_presentation *presentation=nullptr;
+SDL_AudioDeviceID audio_device=0;
+unsigned clock_id=~0u;
+std::atomic<std::uint64_t> audio_frames{0}, zero_pushes{0}, drops{0}, failures{0}, pace_calls{0}, empty_pace{0}, pace_ns{0};
+std::uint64_t start_ns=0;
+void global(void *, wl_registry *r, unsigned name, const char *iface, unsigned version) {
+ if (!std::strcmp(iface, "wp_presentation")) presentation=static_cast<wp_presentation*>(wl_registry_bind(r,name,&wp_presentation_interface,1));
+}
+void removed(void *, wl_registry *, unsigned) {}
+const wl_registry_listener registry_listener={global,removed};
+void clock(void *, wp_presentation *, unsigned id) { clock_id=id; }
+const wp_presentation_listener presentation_listener={clock};
+void sync_output(void *, struct wp_presentation_feedback *, wl_output *) {}
+void presented(void *data, struct wp_presentation_feedback *f, unsigned hi,unsigned lo,unsigned nsec,unsigned refresh,unsigned seqhi,unsigned seqlo,unsigned flags) {
+ auto &r=*static_cast<Frame*>(data); r.displayed=((std::uint64_t(hi)<<32)|lo)*1000000000+nsec; r.refresh=refresh; r.sequence=(std::uint64_t(seqhi)<<32)|seqlo; r.flags=flags; r.status=1; wp_presentation_feedback_destroy(f);
+}
+void discarded(void *data, struct wp_presentation_feedback *f) { static_cast<Frame*>(data)->status=2; wp_presentation_feedback_destroy(f); }
+const wp_presentation_feedback_listener feedback_listener={sync_output,presented,discarded};
+void event(unsigned stage,unsigned w,unsigned h) {
+ if (stage==0) {
+  pump();
+  frames.push_back({unsigned(frames.size()+1),w,h,audio_device?SDL_GetQueuedAudioSize(audio_device):0,ns()});
+  auto &r=frames.back(); r.audio=audio_frames.load();
+  if(presentation) { auto *f=wp_presentation_feedback(presentation,surface); wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(f),queue); wp_presentation_feedback_add_listener(f,&feedback_listener,&r); }
+ } else if (!frames.empty()) { frames.back().end=ns(); if(stage==2) frames.back().status=3; pump(); }
+}
+}
+void pump() {
+ if(!display || !queue) return;
+ wl_display_dispatch_queue_pending(display,queue);
+ if(wl_display_prepare_read_queue(display,queue)==0) {
+  wl_display_flush(display);
+  pollfd p{wl_display_get_fd(display),POLLIN,0};
+  if(poll(&p,1,0)>0 && (p.revents&POLLIN)) wl_display_read_events(display); else wl_display_cancel_read(display);
+  wl_display_dispatch_queue_pending(display,queue);
+ }
+}
+void init(SDL_Window *window, SDL_AudioDeviceID device) {
+ if(!std::getenv("PS2_PRESENT_CSV")) return;
+ audio_device=device; start_ns=ns();
+ SDL_SysWMinfo info; SDL_VERSION(&info.version);
+ if(SDL_GetWindowWMInfo(window,&info) && info.subsystem==SDL_SYSWM_WAYLAND) {
+  display=info.info.wl.display; surface=info.info.wl.surface; queue=wl_display_create_queue(display);
+  registry=wl_display_get_registry(display); wl_proxy_set_queue(reinterpret_cast<wl_proxy*>(registry),queue);
+  wl_registry_add_listener(registry,&registry_listener,nullptr); wl_display_roundtrip_queue(display,queue);
+  if(presentation) { wp_presentation_add_listener(presentation,&presentation_listener,nullptr); wl_display_roundtrip_queue(display,queue); }
+ }
+ std::fprintf(stderr,"[probe] wp_presentation=%d clock_id=%u audio_backend=%s\n",presentation!=nullptr,clock_id,SDL_GetCurrentAudioDriver());
+ ps2::g_options.on_surface_event=event;
+}
+void audio_push(unsigned n,unsigned before,bool dropped,bool failed) {
+ if(!std::getenv("PS2_PRESENT_CSV")) return;
+ const auto prior=audio_frames.fetch_add(n);
+ if(prior>240000 && before==0) ++zero_pushes;
+ if(dropped) drops.fetch_add(n);
+ if(failed) ++failures;
+}
+void pace_sample(unsigned before,unsigned after,double ms) {
+ if(!std::getenv("PS2_PRESENT_CSV")) return;
+ ++pace_calls; if(audio_frames.load()>240000 && (!before || !after)) ++empty_pace;
+ pace_ns.fetch_add(std::uint64_t(ms*1000000));
+}
+void finish() {
+ const char *path=std::getenv("PS2_PRESENT_CSV"); if(!path) return;
+ const auto deadline=ns()+500000000;
+ while(ns()<deadline) { pump(); bool pending=false; for(auto &r:frames) if(!r.status) pending=true; if(!pending) break; SDL_Delay(1); }
+ if(auto *f=std::fopen(path,"w")) {
+  std::fprintf(f,"id,begin_ns,end_ns,displayed_ns,refresh_ns,sequence,flags,status,width,height,audio_queued_bytes,audio_produced_frames\n");
+  for(auto &r:frames) std::fprintf(f,"%u,%llu,%llu,%llu,%u,%llu,%u,%u,%u,%u,%u,%llu\n",r.id,(unsigned long long)r.begin,(unsigned long long)r.end,(unsigned long long)r.displayed,r.refresh,(unsigned long long)r.sequence,r.flags,r.status,r.w,r.h,r.queued,(unsigned long long)r.audio);
+  std::fclose(f);
+ }
+ std::fprintf(stderr,"[probe-audio] produced_frames=%llu zero_pushes_after_5s=%llu empty_pace_after_5s=%llu dropped_frames=%llu queue_failures=%llu pace_calls=%llu pace_wait_ms=%.3f wall_ms=%.3f\n",(unsigned long long)audio_frames.load(),(unsigned long long)zero_pushes.load(),(unsigned long long)empty_pace.load(),(unsigned long long)drops.load(),(unsigned long long)failures.load(),(unsigned long long)pace_calls.load(),pace_ns.load()/1e6,(ns()-start_ns)/1e6);
+ std::fprintf(stderr,"[probe-gpu] busy_ms_estimate=%.3f presents_requested=%zu\n",ps2::gpu_busy_ms(),frames.size());
+ ps2::g_options.on_surface_event={};
+ if(presentation) wp_presentation_destroy(presentation);
+ if(registry) wl_registry_destroy(registry);
+ if(queue) wl_event_queue_destroy(queue);
+}
+}
