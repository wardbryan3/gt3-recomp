+                ps2::st32(input + 0x38, 1023 - axis);
+                ps2::st32(input + 0x78, 1023 - axis);
+                ps2::st32(input + 0x38 + base * 4, axis);
+                ps2::st32(input + 0x3c + base * 4, 255);
+                ps2::st32(input + 0x40 + base * 4, 255);
