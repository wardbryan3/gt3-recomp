new file mode 100755
index 0000000..339647c
--- /dev/null
+++ b/scripts/validate_gt3_clean_steering.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Reuse unchanged live synthetic validator with an isolated clean executable.
+Only enabled cases receive --gt3-clean-steering. Add a pad oracle comparison.
+All cards/captures/traces are disposable and --out must not exist.
+"""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+from types import SimpleNamespace
+
+ROOT = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('synthetic_validator', ROOT/'scripts/validate_gt3_synthetic_wheel.py')
+validator = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(validator)
+clean = ROOT/'build/clean-steering/ps2run'
+original = ROOT/'build/synthetic-wheel/ps2run'
+commands = {}
+
+def run(command, **kwargs):
+    tag = Path(command[command.index('--frames-dir')+1]).parent.name
+    if command[0] == str(original):
+        command[0] = str(clean)
+        if tag not in ('disabled','trace_only'):
+            command.append('--gt3-clean-steering')
+    commands[tag] = (command.copy(), kwargs.copy())
+    return subprocess.run(command, **kwargs)
+
+validator.subprocess = SimpleNamespace(run=run)
+validator.main()
+out = Path(sys.argv[sys.argv.index('--out')+1]).resolve()
+summary = json.loads((out/'summary.json').read_text())
+summary['generated_oracle_sha256'] = summary['experiment_sha256']
+summary['experiment_sha256'] = validator.digest(clean)
+summary['replacement_boundary'] = ['00210F90','002115F8 (shipped input vtable only)','001E4368','001E45A8..001E48FC']
+
+# Run the preserved generated executable again with identical inputs/settings.
+# This is a live generated-code oracle, separate from fixtures and reconstructed formulas.
+for tag, case in list(summary['cases'].items()):
+    if '--gt3-clean-steering' not in case['argv']: continue
+    directory = out/('oracle_'+tag)
+    directory.mkdir(); (directory/'shots').mkdir()
+    command = [s.replace(str(out/tag),str(directory)) for s in case['argv'] if s!='--gt3-clean-steering']
+    command[0] = str(original)
+    env = dict(commands[tag][1]['env'],PS2_DUMP=str(directory/'memory.bin'))
+    with (directory/'run.log').open('w') as log:
+        subprocess.run(command,cwd=ROOT,env=env,stdout=log,stderr=log,timeout=90,check=True)
+    oracle_rows = [json.loads(s) for s in (directory/'trace.jsonl').read_text().splitlines()]
+    clean_rows = [json.loads(s) for s in (out/tag/'trace.jsonl').read_text().splitlines()]
+    assert clean_rows == oracle_rows, f'{tag}: live clean/original semantic traces differ'
+    captures = {p.name:validator.digest(p) for p in sorted((directory/'shots').glob('*.ppm'))}
+    assert captures == case['captures'], f'{tag}: clean/original captures differ'
+    car = next(r['car'] for r in clean_rows if r['stage']=='angles')
+    a = (out/tag/'memory.bin').read_bytes(); b = (directory/'memory.bin').read_bytes()
+    assert a[car:car+0x1800] == b[car:car+0x1800], f'{tag}: final vehicle differs'
+    case['generated_oracle'] = {'argv':command,'exact_trace_match':True,
+        'exact_capture_match':True,'exact_final_vehicle_match':True,
+        'memory_sha256':validator.digest(directory/'memory.bin'),'full_memory_match':a==b}
+
+# Clean pad path: exact per-frame semantic records and rendered captures against
+# the same new executable with its gates disabled. RAM stack scratch is not ABI state.
+command, kw = commands['trace_only']
+command = [s.replace(str(out/'trace_only'), str(out/'enabled_pad')) for s in command]
+command += ['--gt3-clean-steering']
+directory = out/'enabled_pad'
+directory.mkdir(); (directory/'shots').mkdir()
+kw['env'] = dict(kw['env'], PS2_DUMP=str(directory/'memory.bin'))
+with (directory/'run.log').open('w') as log:
+    subprocess.run(command,cwd=ROOT,env=kw['env'],stdout=log,stderr=log,timeout=90,check=True)
+rows = [json.loads(s) for s in (directory/'trace.jsonl').read_text().splitlines()]
+oracle = [json.loads(s) for s in (out/'trace_only/trace.jsonl').read_text().splitlines()]
+assert rows == oracle, 'clean pad semantic trace differs from generated oracle'
+shots = {p.name:validator.digest(p) for p in sorted((directory/'shots').glob('*.ppm'))}
+assert shots == summary['cases']['trace_only']['captures'], 'clean pad capture differs'
+car = next(r['car'] for r in rows if r['stage']=='angles')
+a = (directory/'memory.bin').read_bytes(); b = (out/'trace_only/memory.bin').read_bytes()
+assert a[car:car+0x1800] == b[car:car+0x1800], 'clean pad final vehicle bytes differ'
+summary['cases']['enabled_pad'] = {'argv':command,'records':len(rows),'captures':shots,
+    'exact_trace_match':True,'exact_final_vehicle_match':True,'full_memory_match':a==b,
+    'memory_sha256':validator.digest(directory/'memory.bin')}
+for tag, case in summary['cases'].items():
+    if '--gt3-clean-steering' not in case['argv']: continue
+    text = (out/tag/'run.log').read_text()
+    match = re.search(r'\[gt3-clean\] normalized=(\d+) wheel_commands=(\d+) filters=(\d+) envelopes=(\d+)',text)
+    assert match and int(match[4])>0, f'{tag}: no clean envelope execution'
+    values = dict(zip(['normalized','wheel_commands','filters','envelopes'],map(int,match.groups())))
+    assert values['wheel_commands']>0
+    if tag=='enabled_pad': assert values['filters']>0
+    case['clean_calls'] = values
+summary['evidence_note'] = 'mode4/steering seam records in clean cases are bridge observations; skipped generated instructions did not execute'
+(out/'summary.json').write_text(json.dumps(summary,indent=2)+'\n')
+print('Clean pad: exact per-frame trace, captures and final vehicle bytes PASS')
