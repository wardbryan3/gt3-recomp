diff --git a/host/gt3_clean_steering.cpp b/host/gt3_clean_steering.cpp
new file mode 100644
index 0000000..36876ea
--- /dev/null
+++ b/host/gt3_clean_steering.cpp
@@ -0,0 +1,478 @@
+#include "gt3_clean_steering.hpp"
+#include "ps2/generated.hpp"
+#include <algorithm>
+#include <cstring>
+
+namespace gt3::clean {
+namespace {
+namespace fp = ps2::fp;
+thread_local ps2::Cpu *observation_cpu = nullptr;
+void store_state(unsigned address, const CarPartial &car);
+constexpr EeFloat zero = 0, one = 0x3f800000, fixed_scale = 0x39800000;
+bool less(EeFloat a, EeFloat b) { return fp::key(a) < fp::key(b); }
+bool le(EeFloat a, EeFloat b) { return fp::key(a) <= fp::key(b); }
+EeFloat neg(EeFloat x) { return x ^ fp::kSign; }
+EeFloat fixed(std::int16_t x) {
+    return fp::mul(fp::cvt_s_w(std::uint32_t(std::int32_t(x))), fixed_scale);
+}
+// Explicit wrapping reproduces EE 32-bit arithmetic, including out-of-report inputs.
+std::int32_t signed_word(std::uint32_t x) { return std::bit_cast<std::int32_t>(x); }
+int pedal(std::uint32_t raw, unsigned threshold) {
+    return std::min(signed_word((255u - raw - threshold) << 1), 256);
+}
+} // namespace
+std::int32_t normalize_mapped_channel(std::uint32_t channel, std::uint32_t raw,
+                                      std::int32_t sensitivity, const std::uint8_t *curve,
+                                      Cost &cost) {
+    if ((channel & 255) < 4) {
+        const int response = curve[raw & 255];
+        switch (channel & 0x300) {
+        case 0x100:
+            cost.add(23);
+            return std::max(0, (128 - response) * 2);
+        case 0x200:
+            cost.add(25);
+            return std::max(0, (response - 128) * 2);
+        default:
+            cost.add(20);
+            return response;
+        }
+    }
+    cost.add(21);
+    const int numerator = std::min(int((raw & 255) * 2), 256) * 100;
+    // EE DIV1 returns -1 for nonnegative numerator / zero. BREAK is handled by bridge.
+    return std::min(sensitivity ? numerator / sensitivity : -1, 256);
+}
+void build_wheel_command(const InputPartial &input, Command &command, Cost &cost) {
+    cost.add(13 + 2 + 8); // prologue + shipped digital getter + type decoding
+    const unsigned type = (input.type_bits >> 5) & 7;
+    if (type >= 4) {
+        cost.add(1 + 5);
+        return;
+    }
+    cost.add(2);
+    if (!type) {
+        cost.add(5);
+        return;
+    }
+    const auto mask = input.digital_mask;
+    // 0x00210EF8: digital actions clear analog bits, not the existing command wholesale.
+    for (unsigned i = 0; i < 4; ++i)
+        if (mask & (0x400u << i)) {
+            if (i == 0)
+                command.accelerator = 1;
+            if (i == 1)
+                command.brake = 1;
+            if (i == 2)
+                command.handbrake = 1;
+            if (i == 3)
+                command.auxiliary = 1;
+            command.analog_flags &= ~(i == 2 ? 16u : i == 3 ? 8u : 2u << i);
+            cost.add(4);
+        }
+    command.shift = mask & 0x8000 ? -1 : (mask >> 14) & 1;
+    cost.add(2 + 15 + (mask & 0x8000 ? 2 : 4));
+    const unsigned bank = (input.type_bits & 31) ? 16 : 0;
+    const auto raw = input.channels[bank];
+    const int q = signed_word((512u - raw) * 9u);
+    command.steering = std::clamp(q, -4096, 4096);
+    command.steering_mode = 4;
+    command.analog_flags |= 1;
+    cost.add(6 + 4 + 7 + 2 + 12 + 4);
+    const int accelerator = pedal(input.channels[bank + 1], 75);
+    cost.add(3 + 8 + 3);
+    if (accelerator > 0) {
+        command.accelerator = std::uint16_t(std::uint32_t(accelerator) << 4);
+        command.analog_flags |= 2;
+        cost.add(4);
+    }
+    cost.add(6 + 4);
+    const int brake = pedal(input.channels[bank + 2], 80);
+    cost.add(3 + 8 + 3);
+    if (brake > 0) {
+        command.brake = std::uint16_t(std::uint32_t(brake) << 4);
+        command.analog_flags |= 4;
+        cost.add(4);
+    }
+    cost.add(1 + 5);
+}
+EeFloat slew_limit(EeFloat current, EeFloat target, EeFloat step, Cost &cost) {
+    cost.add(4);
+    if (less(current, target)) {
+        current = fp::add(current, step);
+        cost.add(4 + 2);
+        if (less(target, current))
+            current = target;
+    } else {
+        cost.add(3);
+        if (less(target, current)) {
+            current = fp::sub(current, step);
+            cost.add(3 + 2);
+            if (less(current, target))
+                current = target;
+        }
+    }
+    cost.add(2);
+    return current;
+}
+void filter_stick(CarPartial &car, EeFloat target, EeFloat outward_rate, EeFloat return_rate,
+                  const Constants &k, Cost &cost) {
+    if (enabled)
+        ++counts.filters;
+    const auto old = car.steering;
+    auto acceleration =
+        fp::sub(fp::mul(fp::sub(target, old), k.spring), fp::mul(car.steering_rate, k.damping));
+    cost.add(15);
+    bool returning = false;
+    if (less(zero, old)) {
+        cost.add(4);
+        returning = less(target, old);
+    }
+    if (!returning) {
+        cost.add(4);
+        if (less(old, zero)) {
+            cost.add(4);
+            returning = less(old, target);
+        }
+    }
+    if (returning) {
+        outward_rate = return_rate;
+        acceleration = fp::sub(acceleration, fp::mul(old, k.return_spring));
+        cost.add(3);
+    }
+    // Positive/returning path reaches 43E0; nonnegative/nonreturning bypasses it.
+    if (returning || less(old, zero))
+        cost.add(1);
+    auto rate = fp::add(car.steering_rate, fp::mul(acceleration, car.dt));
+    cost.add(5);
+    if (less(outward_rate, rate)) {
+        rate = outward_rate;
+        cost.add(1);
+    } else {
+        cost.add(5);
+        if (less(rate, neg(outward_rate))) {
+            rate = neg(outward_rate);
+            cost.add(2);
+        }
+    }
+    const auto next = fp::add(old, fp::mul(rate, car.dt));
+    cost.add(4);
+    bool crossed = false;
+    if (le(old, target)) {
+        cost.add(4);
+        crossed = le(target, next);
+    }
+    if (!crossed) {
+        cost.add(4);
+        if (le(target, old)) {
+            cost.add(4);
+            crossed = le(next, target);
+            if (crossed)
+                cost.add(1);
+        }
+    }
+    cost.add(2);
+    car.steering = crossed ? target : next;
+    car.steering_rate = crossed ? zero : rate;
+}
+bool process_steering(CarPartial &car, const Command &command, std::uint8_t &kind, EeFloat high,
+                      EeFloat average, unsigned classification, const Constants &k, Cost &cost) {
+    cost.add(4);
+    bool extend = true;
+    if (command.steering_mode == 4) {
+        const int policy = car.wheel_policy;
+        cost.add(2 + 2 + 4); // call signed policy getter
+        EeFloat floor = high;
+        if (policy == 2) {
+            cost.add(2 + (classification == 1 ? 1 : 0));
+            floor = k.policy2[classification == 1];
+        } else {
+            cost.add(2);
+            if (policy < 3) {
+                cost.add(2);
+                if (policy != 1)
+                    cost.add(2);
+            } else {
+                cost.add(2);
+                if (policy == 3) {
+                    extend = false;
+                    cost.add(1);
+                } else {
+                    cost.add(2);
+                    extend = false;
+                    if (policy != 4) {
+                        extend = true;
+                        cost.add(2);
+                    }
+                }
+            }
+            if (policy == 1 || policy == 3) {
+                floor = k.policy1[classification == 1];
+                cost.add(2 + (classification == 1 ? 2 : 0));
+            }
+        }
+        if (policy == 1 || policy == 2 || policy == 3) {
+            cost.add(4);
+            if (less(high, floor)) {
+                high = floor;
+                cost.add(1);
+            } else
+                cost.add(2);
+        } else if (policy == 4)
+            cost.add(1);
+    } else
+        cost.add(1);
+    auto low = neg(high);
+    cost.add(2);
+    if (extend) {
+        cost.add(3);
+        bool outside = !le(low, average);
+        if (!outside) {
+            cost.add(3);
+            outside = !le(average, high);
+        }
+        if (!outside) {
+            car.envelope_ratio = zero;
+            cost.add(2 + 1);
+        } else {
+            cost.add(4);
+            if (less(zero, average)) {
+                high = average;
+                car.envelope_ratio = average;
+                cost.add(3 + 1);
+            } else {
+                cost.add(4);
+                if (less(average, zero)) {
+                    low = average;
+                    car.envelope_ratio = average;
+                    cost.add(2 + 1);
+                }
+            }
+        }
+    }
+    if (less(car.mechanical_limit, high))
+        high = car.mechanical_limit;
+    if (less(low, neg(car.mechanical_limit)))
+        low = neg(car.mechanical_limit);
+    car.unknown13a4 = one; // Assignment evidenced; field's larger purpose is not established.
+    cost.add(4 + 5 + 7);
+    const int q = command.steering;
+    if (!(command.analog_flags & 1)) {
+        kind = 1;
+        car.positive_limit = high;
+        car.negative_limit = low;
+        cost.add(7);
+        auto target = high;
+        if (q <= 0) {
+            cost.add(3);
+            target = q < 0 ? low : zero;
+            if (q == 0)
+                cost.add(2);
+        }
+        if (q != 0)
+            cost.add(1);
+        cost.add(10);
+        filter_stick(car, target, k.digital_outward[classification],
+                     k.digital_return[classification], k, cost);
+        cost.add(2);
+    } else {
+        cost.add(4);
+        if (command.steering_mode == 4) {
+            // Feed the independent, unchanged synthetic observer at its original semantic seams.
+            // These are observations of clean execution, not execution of skipped EE instructions.
+            if (observation_cpu) {
+                observation_cpu->f[20] = high;
+                observation_cpu->f[21] = low;
+                ps2::probe(*observation_cpu, 0x1e471c);
+            }
+            kind = 0;
+            car.previous_wheel_command = car.wheel_command;
+            car.wheel_command = q;
+            auto target = fixed(q);
+            const int policy = car.wheel_policy;
+            cost.add(12 + 2 + 3);
+            if (policy < 0) {
+                target = zero;
+                cost.add(1);
+            } else {
+                cost.add(2);
+                if (policy < 4) {
+                    const auto step = fp::mul(k.limit_slew, car.dt);
+                    cost.add(4);
+                    car.positive_limit = slew_limit(car.positive_limit, high, step, cost);
+                    cost.add(5);
+                    car.negative_limit = slew_limit(car.negative_limit, low, step, cost);
+                    cost.add(5 + 3);
+                    target = fp::mul(
+                        le(zero, target) ? car.positive_limit : neg(car.negative_limit), target);
+                } else {
+                    cost.add(2);
+                    if (policy == 4) {
+                        target = fp::mul(car.mechanical_limit, target);
+                        cost.add(2);
+                    } else {
+                        target = zero;
+                        cost.add(2 + 1);
+                    }
+                }
+            }
+            car.steering = target;
+            cost.add(2 + 1);
+            if (observation_cpu) {
+                store_state(observation_cpu->r[23].w[0], car);
+                ps2::st8(observation_cpu->r[19].w[0] + 3, kind);
+                ps2::probe(*observation_cpu, 0x1e48a0);
+            }
+        } else {
+            cost.add(4);
+            if (command.steering_mode == 2 || command.steering_mode == 3) {
+                car.positive_limit = high;
+                car.negative_limit = low;
+                auto target = fixed(q);
+                cost.add(13);
+                if (le(zero, target)) {
+                    target = fp::mul(high, target);
+                    cost.add(2);
+                } else {
+                    target = fp::mul(neg(low), target);
+                    cost.add(1);
+                }
+                cost.add(2);
+                if (q) {
+                    kind = command.steering_mode == 3 ? 1 : 2;
+                    cost.add(3 + (kind == 1 ? 1 : 0) + 1);
+                }
+                cost.add(4);
+                if (kind == 1) {
+                    cost.add(1 + 10);
+                    filter_stick(car, target, k.digital_outward[classification],
+                                 k.digital_return[classification], k, cost);
+                    cost.add(2);
+                } else {
+                    cost.add(7);
+                    filter_stick(car, target, k.analog_rate[classification],
+                                 k.analog_rate[classification], k, cost);
+                    cost.add(1);
+                }
+            }
+        }
+    }
+    bool invalid = false;
+    cost.add(5);
+    if (fp::key(car.envelope_ratio) != fp::key(zero)) {
+        const auto result = fp::div(car.steering, car.envelope_ratio);
+        invalid = result.invalid;
+        car.envelope_ratio = result.value;
+        cost.add(8 + 1);
+        if (less(car.envelope_ratio, zero)) {
+            car.envelope_ratio = zero;
+            cost.add(2);
+        } else {
+            cost.add(6);
+            if (less(one, car.envelope_ratio))
+                car.envelope_ratio = one;
+        }
+    }
+    return invalid;
+}
+bool profile_matches() {
+    return ps2::ld32(0x210f90) == 0x308300ff && ps2::ld32(0x1e4368) == 0xc4870ec0 &&
+           ps2::ld32(0x1e45a8) == 0x92510001 && ps2::ld32(0x1e48fc) == 0x24020001;
+}
+bool enabled = false;
+Counts counts;
+namespace {
+Constants constants(unsigned gp) {
+    Constants k{};
+    k.spring = ps2::ld32(gp - 20608);
+    k.damping = ps2::ld32(gp - 20604);
+    k.return_spring = ps2::ld32(gp - 20600);
+    k.limit_slew = ps2::ld32(gp - 20596);
+    for (unsigned i = 0; i < 2; ++i) {
+        k.policy1[i] = ps2::ld32(gp - 20592 + i * 4);
+        k.policy2[i] = ps2::ld32(gp - 20584 + i * 4);
+    }
+    for (unsigned i = 0; i < 3; ++i) {
+        k.digital_outward[i] = ps2::ld32(0x49d080 + i * 4);
+        k.digital_return[i] = ps2::ld32(0x49d090 + i * 4);
+        k.analog_rate[i] = ps2::ld32(0x49d0a0 + i * 4);
+    }
+    return k;
+}
+template <class T> T read(unsigned address) {
+    T result;
+    std::memcpy(&result, ps2::g_ram + address, sizeof(T));
+    return result;
+}
+void store_state(unsigned address, const CarPartial &car) {
+    // Only evidenced writes; never bulk-write opaque vehicle padding.
+    ps2::st32(address + 0x13a0, car.steering);
+    ps2::st32(address + 0x13a4, car.unknown13a4);
+    ps2::st32(address + 0x13a8, car.steering_rate);
+    ps2::st32(address + 0x1420, car.envelope_ratio);
+    ps2::st32(address + 0x142c, car.negative_limit);
+    ps2::st32(address + 0x1430, car.positive_limit);
+    ps2::st16(address + 0x16a4, car.wheel_command);
+    ps2::st16(address + 0x16a6, car.previous_wheel_command);
+}
+} // namespace
+bool replace(ps2::Cpu &cpu, std::uint32_t address) {
+    if (!enabled)
+        return false;
+    Cost cost;
+    if (address == 0x210f90) {
+        if (!cpu.r[6].d[0] && (cpu.r[4].w[0] & 255) >= 4)
+            ps2::breakpoint(cpu, 0x21102c);
+        ps2::set32(cpu.r[2], normalize_mapped_channel(cpu.r[4].w[0], cpu.r[5].w[0], cpu.r[6].sw[0],
+                                                      ps2::g_ram + 0x3416f8, cost));
+        ++counts.normalized;
+        cpu.pc = cpu.r[31].w[0];
+    } else if (address == 0x2115f8) {
+        if (cpu.r[4].w[0] > 0x2000000 - sizeof(InputPartial) ||
+            cpu.r[5].w[0] > 0x2000000 - sizeof(Command))
+            return false;
+        const auto input = read<InputPartial>(cpu.r[4].w[0]);
+        if (input.vtable != 0x33f7e0 || ps2::ld16(input.vtable + 0x28) ||
+            ps2::ld16(input.vtable + 0x40) || ps2::ld32(input.vtable + 0x2c) != 0x22dfa8 ||
+            ps2::ld32(input.vtable + 0x44) != 0x22e000)
+            return false;
+        auto command = read<Command>(cpu.r[5].w[0]);
+        build_wheel_command(input, command, cost);
+        std::memcpy(ps2::g_ram + cpu.r[5].w[0], &command, sizeof(command));
+        ++counts.wheel_commands;
+        cpu.pc = cpu.r[31].w[0];
+    } else if (address == 0x1e4368) {
+        const auto car_address = cpu.r[4].w[0];
+        if (car_address > 0x2000000 - sizeof(CarPartial))
+            return false;
+        auto car = read<CarPartial>(car_address);
+        filter_stick(car, cpu.f[12], cpu.f[13], cpu.f[14], constants(cpu.r[28].w[0]), cost);
+        ps2::st32(car_address + 0x13a0, car.steering);
+        ps2::st32(car_address + 0x13a8, car.steering_rate);
+        cpu.pc = cpu.r[31].w[0];
+    } else if (address == 0x1e45a8) {
+        const auto car_address = cpu.r[23].w[0];
+        if (car_address > 0x2000000 - sizeof(CarPartial) ||
+            cpu.r[18].w[0] > 0x2000000 - sizeof(Command) || cpu.r[19].w[0] > 0x2000000 - 4)
+            return false;
+        auto car = read<CarPartial>(car_address);
+        const auto command = read<Command>(cpu.r[18].w[0]);
+        auto kind = ps2::ld8(cpu.r[19].w[0] + 3);
+        if (cpu.r[21].w[0] > 2)
+            return false; // unevidenced classification/table indices stay generated
+        observation_cpu = &cpu;
+        if (process_steering(car, command, kind, cpu.f[0], cpu.f[22], cpu.r[21].w[0],
+                             constants(cpu.r[28].w[0]), cost))
+            cpu.fcr31 |= 0x30000;
+        observation_cpu = nullptr;
+        store_state(car_address, car);
+        ps2::st8(cpu.r[19].w[0] + 3, kind);
+        cpu.r[3].sd[0] = car.control_kind136d;
+        ++counts.envelopes;
+        cpu.pc = 0x1e48fc;
+    } else
+        return false;
+    cpu.budget -= cost.instructions;
+    return true;
+}
+} // namespace gt3::clean
diff --git a/host/gt3_clean_steering.hpp b/host/gt3_clean_steering.hpp
new file mode 100644
index 0000000..66aa2db
--- /dev/null
+++ b/host/gt3_clean_steering.hpp
@@ -0,0 +1,83 @@
+#pragma once
+#include "ps2/cpu.hpp"
+#include <cstddef>
+#include <cstdint>
+
+// GT3 USA v1.10 only. Addresses and evidence ledger: docs/gt3-clean-steering.md.
+namespace gt3::clean {
+// Floating fields store EE bit patterns, not host arithmetic values.
+using EeFloat = std::uint32_t;
+struct Command {
+    std::uint8_t analog_flags, steering_mode;
+    std::int8_t shift;
+    std::uint8_t unknown03;
+    std::int16_t steering, opposing_pressure, accelerator, brake, auxiliary, handbrake;
+};
+struct InputPartial {
+    std::byte unknown00[0x14];
+    std::uint32_t type_bits;
+    std::byte unknown18[0x14];
+    std::uint32_t digital_mask;
+    std::byte unknown30[8];
+    std::uint32_t channels[32];
+    std::byte unknownb8[8];
+    std::uint32_t vtable;
+};
+struct CarPartial {
+    std::byte unknown00[0x68];
+    EeFloat mechanical_limit;
+    std::byte unknown6c[0xec0 - 0x6c];
+    EeFloat dt;
+    std::byte unknownec4[0x136d - 0xec4];
+    std::int8_t control_kind136d, unknown136e, wheel_policy;
+    std::byte unknown1370[0x13a0 - 0x1370];
+    EeFloat steering, unknown13a4, steering_rate;
+    std::byte unknown13ac[0x1420 - 0x13ac];
+    EeFloat envelope_ratio;
+    std::byte unknown1424[8];
+    EeFloat negative_limit, positive_limit;
+    std::byte unknown1434[0x16a4 - 0x1434];
+    std::int16_t wheel_command, previous_wheel_command;
+};
+static_assert(sizeof(Command) == 16 && offsetof(Command, steering) == 4 &&
+              offsetof(Command, accelerator) == 8);
+static_assert(offsetof(InputPartial, digital_mask) == 0x2c &&
+              offsetof(InputPartial, channels) == 0x38 && offsetof(InputPartial, vtable) == 0xc0);
+static_assert(offsetof(CarPartial, mechanical_limit) == 0x68 && offsetof(CarPartial, dt) == 0xec0);
+static_assert(offsetof(CarPartial, wheel_policy) == 0x136f &&
+              offsetof(CarPartial, steering) == 0x13a0);
+static_assert(offsetof(CarPartial, steering_rate) == 0x13a8 &&
+              offsetof(CarPartial, envelope_ratio) == 0x1420);
+static_assert(offsetof(CarPartial, negative_limit) == 0x142c &&
+              offsetof(CarPartial, positive_limit) == 0x1430);
+static_assert(offsetof(CarPartial, wheel_command) == 0x16a4 && sizeof(CarPartial) == 0x16a8);
+struct Constants {
+    EeFloat spring, damping, return_spring, limit_slew;
+    EeFloat policy1[2], policy2[2];
+    EeFloat digital_outward[3], digital_return[3], analog_rate[3];
+};
+struct Cost {
+    unsigned instructions = 0;
+    void add(unsigned n) { instructions += n; }
+};
+std::int32_t normalize_mapped_channel(std::uint32_t channel, std::uint32_t raw,
+                                      std::int32_t sensitivity, const std::uint8_t *curve,
+                                      Cost &cost);
+void build_wheel_command(const InputPartial &input, Command &command, Cost &cost);
+EeFloat slew_limit(EeFloat current, EeFloat target, EeFloat step, Cost &cost);
+void filter_stick(CarPartial &car, EeFloat target, EeFloat outward_rate, EeFloat return_rate,
+                  const Constants &constants, Cost &cost);
+// Original prefix supplies curve result, averaged wheel quantity and classification.
+// This is NOT a replacement for the pedal/control tail of 0x001E4478.
+bool process_steering(CarPartial &car, const Command &command, std::uint8_t &steering_kind,
+                      EeFloat curve_limit, EeFloat averaged_wheel_quantity, unsigned classification,
+                      const Constants &constants, Cost &cost);
+bool profile_matches();
+extern bool enabled;
+struct Counts {
+    std::uint64_t normalized = 0, wheel_commands = 0, filters = 0, envelopes = 0;
+};
+extern Counts counts;
+// Called only by the isolated generated copy. Returns false for unsupported input vtables.
+bool replace(ps2::Cpu &cpu, std::uint32_t address);
+} // namespace gt3::clean
diff --git a/host/gt3_synthetic_wheel.cpp b/host/gt3_synthetic_wheel.cpp
new file mode 100644
index 0000000..e579297
--- /dev/null
+++ b/host/gt3_synthetic_wheel.cpp
@@ -0,0 +1,163 @@
+#include "gt3_synthetic_wheel.hpp"
+#include "ps2/memory.hpp"
+#include "ps2/system.hpp"
+#include <algorithm>
+#include <bit>
+#include <cerrno>
+#include <cmath>
+#include <cstdlib>
+#include <utility>
+
+namespace gt3::synthetic {
+namespace {
+bool ram(std::uint32_t address, unsigned size) {
+    return address && !(address & 3) && address <= ps2::kRamSize - size;
+}
+float f(std::uint32_t address) { return std::bit_cast<float>(ps2::ld32(address)); }
+float approach(float state, float target, float step) {
+    return state < target ? std::min(state + step, target) : std::max(state - step, target);
+}
+}
+bool parse_value(const char *text, double &value) {
+    if (!text || !*text) return false;
+    char *end = nullptr;
+    errno = 0;
+    const double parsed = std::strtod(text, &end);
+    if (errno || end == text || *end || !std::isfinite(parsed) || parsed < -1 || parsed > 1) return false;
+    value = parsed;
+    return true;
+}
+bool parse_event(const char *text, Event &event) {
+    if (!text || *text < '0' || *text > '9') return false;
+    char *end = nullptr;
+    errno = 0;
+    const auto frame = std::strtoull(text, &end, 10);
+    if (errno || end == text || *end != ':') return false;
+    double value;
+    if (!parse_value(end + 1, value)) return false;
+    event = {frame, value};
+    return true;
+}
+int axis_for_value(double value) {
+    if (!std::isfinite(value) || value < -1 || value > 1) return -1;
+    if (value == 1) return 0;
+    if (value == -1) return 1023;
+    return 512 - int(std::lround(value * (4096.0 / 9.0)));
+}
+bool profile_matches() {
+    // Unmodified steering instructions in original and triple GT3 v1.10.
+    // Full source/profile SHA-256 checks are additionally enforced by the build script.
+    for (const auto &word : std::array<std::array<unsigned, 2>, 8>{{
+             {0x2107ac, 0x0200202d}, {0x2107b0, 0x0c08457e},
+             {0x2107b8, 0x260400cc}, {0x2115f8, 0x27bdffc0},
+             {0x1e470c, 0x24020004}, {0x1e48a0, 0xc601049c},
+             {0x1e8910, 0x44800800}, {0x1e7328, 0x27bdffb0}}})
+        if (ps2::ld32(word[0]) != word[1]) return false;
+    return ps2::ld32(0x33f824) == 0x22e000 && ps2::ld32(0x33f808) == 0;
+}
+Experiment::Experiment(Options options) : options_(std::move(options)) {}
+Experiment::~Experiment() { if (trace_) std::fclose(trace_); }
+bool Experiment::open_trace() {
+    if (options_.trace_path.empty()) return true;
+    trace_ = std::fopen(options_.trace_path.c_str(), "wx"); // never overwrite existing evidence
+    if (!trace_) { std::perror("synthetic wheel trace"); return false; }
+    return true;
+}
+double Experiment::value_at(std::uint64_t frame) const {
+    double value = options_.value;
+    for (const auto &event : options_.events) {
+        if (event.frame > frame) break;
+        value = event.value;
+    }
+    return value;
+}
+void Experiment::record(const char *stage, std::uint32_t pc, std::uint64_t frame,
+                        double expected, double error) {
+    if (!trace_ || !player_car_) return;
+    std::fprintf(trace_,
+        "{\"stage\":\"%s\",\"pc\":%u,\"frame\":%llu,\"enabled\":%s,"
+        "\"car\":%u,\"input\":%u,\"host\":%.9g,\"axis\":%d,\"q\":%d,\"mode\":%u,\"flags\":%u,"
+        "\"policy\":%d,\"steering\":%.9g,\"high\":%.9g,\"low\":%.9g,\"mechanical\":%.9g,"
+        "\"rate\":%.9g,\"wheel0\":%.9g,\"wheel1\":%.9g,\"expected\":%.9g,\"error\":%.9g}\n",
+        stage, pc, static_cast<unsigned long long>(frame), options_.enabled ? "true" : "false",
+        player_car_, input_, value_, axis_, q_, mode_, flags_, policy_,
+        f(player_car_ + 0x13a0), f(player_car_ + 0x1430), f(player_car_ + 0x142c),
+        f(player_car_ + 0x68), f(player_car_ + 0x13a8),
+        f(player_car_ + 0xff0), f(player_car_ + 0x1094), expected, error);
+}
+void Experiment::probe(ps2::Cpu &c, std::uint32_t pc, std::uint64_t frame) {
+    if (pc == 0x1e4d38) {
+        const auto car = c.r[4].w[0];
+        context_car_ = ram(car, 0x1800) && ps2::ld8(car + 0x136d) == 0 &&
+            (!ps2::ld8(car + 0x14b8) || ps2::ld16(car + 0x14ba)) ? car : 0;
+    } else if (pc == 0x1e4d5c) {
+        context_car_ = 0; // input builder has returned; no stale scope in menus/other callers
+    } else if (pc == 0x2107ac) {
+        const auto input = c.r[16].w[0], command = c.r[17].w[0];
+        if (!context_car_ || !ram(input, 0x150) || !ram(command, 16) ||
+            ps2::ld32(context_car_ + 12) != input || ps2::ld32(input + 0xc0) != 0x33f7e0) return;
+        player_car_ = context_car_; input_ = input; command_ = command;
+        value_ = value_at(frame); axis_ = axis_for_value(value_);
+        if (options_.enabled) {
+            if (scoped_ || axis_ < 0) { ps2::halt("synthetic wheel invalid/nested scope"); return; }
+            channels_ = input + ((ps2::ld32(input + 0x14) & 31) ? 0x78 : 0x38);
+            saved_ = {ps2::ld32(input + 0x14), ps2::ld32(input + 0x2c),
+                      ps2::ld32(channels_), ps2::ld32(channels_ + 4), ps2::ld32(channels_ + 8)};
+            shift_ = ps2::ld8(command + 2);
+            ps2::st32(input + 0x14, (saved_[0] & ~0xe0u) | 0x20u);
+            ps2::st32(input + 0x2c, 0); // pad already built; don't reapply its digital actions
+            ps2::st32(channels_, axis_);
+            ps2::st32(channels_ + 4, 255); ps2::st32(channels_ + 8, 255); // no synthetic pedals
+            scoped_ = true;
+        }
+        record("input", pc, frame);
+    } else if (pc == 0x2107b8) {
+        if (c.r[16].w[0] != input_ || c.r[17].w[0] != command_) return;
+        if (scoped_) {
+            ps2::st32(input_ + 0x14, saved_[0]); ps2::st32(input_ + 0x2c, saved_[1]);
+            for (unsigned i = 0; i < 3; ++i) ps2::st32(channels_ + 4 * i, saved_[i + 2]);
+            ps2::st8(command_ + 2, shift_); // digital helper sets this even for a zero mask
+            scoped_ = false;
+        }
+        q_ = std::int16_t(ps2::ld16(command_ + 4));
+        mode_ = ps2::ld8(command_ + 1); flags_ = ps2::ld8(command_);
+        record("command", pc, frame);
+    } else if (pc == 0x1e4478 && c.r[4].w[0] == player_car_ && player_car_) {
+        const auto command = c.r[5].w[0];
+        if (!ram(command, 16)) return;
+        q_ = std::int16_t(ps2::ld16(command + 4)); mode_ = ps2::ld8(command + 1);
+        flags_ = ps2::ld8(command); policy_ = std::int8_t(ps2::ld8(player_car_ + 0x136f));
+        record("process", pc, frame);
+    } else if (pc == 0x1e471c && c.r[23].w[0] == player_car_ && player_car_) {
+        const float step = f(0x35297c) * f(player_car_ + 0xec0);
+        expected_high_ = f(player_car_ + 0x1430); expected_low_ = f(player_car_ + 0x142c);
+        rate_ = f(player_car_ + 0x13a8);
+        expected_ = 0;
+        if (policy_ >= 0 && policy_ < 4) {
+            expected_high_ = approach(expected_high_, std::bit_cast<float>(c.f[20]), step);
+            expected_low_ = approach(expected_low_, std::bit_cast<float>(c.f[21]), step);
+            expected_ = (q_ >= 0 ? expected_high_ : -expected_low_) * (float(q_) / 4096.0f);
+        } else if (policy_ == 4) expected_ = f(player_car_ + 0x68) * (float(q_) / 4096.0f);
+        record("mode4", pc, frame, expected_);
+    } else if (pc == 0x1e48a0 && c.r[23].w[0] == player_car_ && player_car_ && mode_ == 4 && (flags_ & 1)) {
+        const float error = std::max({std::abs(f(player_car_ + 0x13a0) - expected_),
+            std::abs(f(player_car_ + 0x1430) - expected_high_),
+            std::abs(f(player_car_ + 0x142c) - expected_low_),
+            std::abs(f(player_car_ + 0x13a8) - rate_)});
+        record("steering", pc, frame, expected_, error);
+    } else if (pc == 0x1e8910 && c.r[4].w[0] == player_car_ + 0x10 && player_car_) {
+        record("consume", pc, frame, f(player_car_ + 0x13a0),
+               std::abs(std::bit_cast<float>(c.f[12]) - f(player_car_ + 0x13a0)));
+    } else if (pc == 0x1e7328 && c.r[4].w[0] == player_car_ && player_car_) {
+        const float steering = f(player_car_ + 0x13a0);
+        float error = 0;
+        for (unsigned i = 0; i < 4; ++i) {
+            const float angle = (i < 2 ? steering * f(player_car_ + 0x120 +
+                4 * (steering < 0 ? 1 - i : i)) : 0) +
+                (i & 1 ? 1 : -1) * f(player_car_ + 0xe30 + 4 * (i >> 1));
+            error = std::max(error, std::abs(f(player_car_ + 0xff0 + i * 0xa4) - angle));
+        }
+        record("angles", pc, frame, steering, error);
+    }
+}
+}
