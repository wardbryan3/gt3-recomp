+    ps2::call(c,entry,0);
+    if(c.pc!=0x1000000 || c.r[29].w[0]!=0x800000)std::abort();
+}
+}
+int main(int argc,char **argv) {
+    if(argc!=2)return 2;register_generated_code();unsigned entry;
