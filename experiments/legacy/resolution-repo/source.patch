new file mode 100755
index 0000000..eec389c
--- /dev/null
+++ b/scripts/validate_gt3_synthetic_wheel.py
@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""Opt-in live race continuation, not an EE fixture. Uses disposable cards only.
+The known race-start snapshot resumes at guest frame 4801. No source assets written.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[1]
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--snapshot', type=Path, required=True)
+    parser.add_argument('--out', type=Path, required=True, help='new experiment-only output directory')
+    parser.add_argument('--window', action='store_true', help='also show +0.5/-0.5 cases in native windows')
+    args = parser.parse_args()
+    snapshot = args.snapshot.resolve(strict=True)
+    out = args.out.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    env = dict(os.environ, PS2_ONE_THREAD='1', SDL_AUDIODRIVER='dummy')
+    if args.window:
+        env.setdefault('SDL_VIDEODRIVER', 'wayland')
+        env.setdefault('WAYLAND_DISPLAY', 'wayland-0')
+        env.setdefault('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
+    experiment = ROOT / 'build/synthetic-wheel/ps2run'
+    baseline = ROOT / 'build/resolution-triple/ps2run'
+    base = [str(ROOT / 'games/gt3-usa-v110/core-triple.elf'), '--disc',
+            str(ROOT / 'games/gt3-usa-v110/disc.iso'), '--ntsc', '--gt3-triple',
+            '--load-state', str(snapshot), '--frames', '5001', '--render-scale', '1',
+            '--render-scale-y', '1', '--output-size', '1280x240', '--frame-every', '100']
+    summary = {'snapshot': str(snapshot), 'snapshot_sha256': digest(snapshot),
+               'experiment_sha256': digest(experiment), 'baseline_sha256': digest(baseline), 'cases': {}}
+
+    def run(tag, extra, binary=experiment, window=False, trace=True):
+        directory = out / tag
+        directory.mkdir()
+        (directory / 'shots').mkdir()
+        command = [str(binary), *base, '--memcard', str(directory / 'card.ps2'),
+                   '--frames-dir', str(directory / 'shots'), *extra]
+        if trace:
+            command += ['--gt3-wheel-trace', str(directory / 'trace.jsonl')]
+        if window:
+            command += ['--window']
+        run_env = dict(env, PS2_DUMP=str(directory / 'memory.bin'))
+        with (directory / 'run.log').open('w') as log:
+            subprocess.run(command, cwd=ROOT, env=run_env, stdout=log, stderr=log, timeout=90, check=True)
+        text = (directory / 'run.log').read_text()
+        assert '[state] loaded frame 4801' in text and 'frame limit reached' in text, tag
+        frames = list((directory / 'shots').glob('*.ppm'))
+        assert frames, f'{tag}: no rendered race capture'
+        summary['cases'][tag] = {'argv': command, 'window': window,
+            'memory_sha256': digest(directory / 'memory.bin'),
+            'captures': {p.name: digest(p) for p in sorted(frames)}}
+        return [json.loads(line) for line in (directory / 'trace.jsonl').open()] if trace else []
+
+    def check(rows, value=None):
+        counts = {stage: sum(r['stage'] == stage for r in rows) for stage in
+                  ['input', 'command', 'process', 'mode4', 'steering', 'consume', 'angles']}
+        assert all(counts.values()), counts
+        assert counts['consume'] == 4 * counts['angles'], counts
+        assert counts['mode4'] == counts['steering'] == counts['angles'], counts
+        errors = [r['error'] for r in rows if r['stage'] in ['steering', 'consume', 'angles']]
+        assert max(errors) <= 2e-6, max(errors)
+        for row in rows:
+            if row['stage'] in ['command', 'process', 'mode4', 'steering']:
+                assert row['mode'] == 4 and row['flags'] & 1, row
+                axes = {-1: 1023, -0.5: 740, -0.25: 626, 0: 512, 0.25: 398, 0.5: 284, 1: 0}
+                assert row['axis'] == axes[row['host']], row
+                assert row['q'] == max(-4096, min(4096, (512 - row['axis']) * 9)), row
+            if row['stage'] == 'steering':
+                assert abs(row['steering'] - row['expected']) <= 2e-6, row
+                if value is not None:
+                    assert row['host'] == value, row
+                    assert row['steering'] * value > 0 if value else row['steering'] == 0, row
+        return {'counts': counts, 'max_reconstruction_error': max(errors),
+                'first_steering': next(r for r in rows if r['stage'] == 'steering'),
+                'last_angles': next(r for r in reversed(rows) if r['stage'] == 'angles')}
+
+    for value in [-1, -0.5, -0.25, 0, 0.25, 0.5, 1]:
+        tag = ('negative' if value < 0 else 'positive' if value > 0 else 'center') + str(abs(value))
+        rows = run(tag, ['--press', '4801:cross:1000', '--gt3-wheel', str(value)],
+                   window=args.window and abs(value) == 0.5)
+        summary['cases'][tag].update(check(rows, value))
+        print(tag, 'live mode4 -> steering -> wheel angles PASS')
+    rows = run('transition', ['--press', '4801:cross:1000', '--gt3-wheel', '0.5',
+                             '--gt3-wheel-at', '4881:0', '--gt3-wheel-at', '4941:-0.5'])
+    summary['cases']['transition'].update(check(rows))
+    for row in rows:
+        if row['stage'] == 'steering':
+            value = 0.5 if row['frame'] < 4881 else 0 if row['frame'] < 4941 else -0.5
+            assert row['host'] == value
+            assert row['steering'] * value > 0 if value else row['steering'] == 0
+    print('transition +0.5 -> center -> -0.5 PASS')
+    # Let the actual race accelerate straight first, then show a brief steering
+    # input at speed. These are full-game continuations, never direct car writes.
+    for sign in [1, -1]:
+        tag = 'moving_positive' if sign > 0 else 'moving_negative'
+        rows = run(tag, ['--frames', '5701', '--press', '4801:cross:2000',
+                         '--gt3-wheel', '0', '--gt3-wheel-at', f'5600:{sign * 0.5}'], window=args.window)
+        summary['cases'][tag].update(check(rows))
+        assert summary['cases'][tag]['last_angles']['steering'] * sign > 0
+        print(tag, 'accelerated live race and opposite-sign steering PASS')
+    run('baseline', ['--press', '4801:cross+left:1000'], binary=baseline, trace=False)
+    run('disabled', ['--press', '4801:cross+left:1000'], trace=False)
+    rows = run('trace_only', ['--press', '4801:cross+left:1000'])
+    assert not any(r['stage'] == 'mode4' for r in rows)
+    assert any(r['stage'] == 'process' and r['mode'] in (2, 3) for r in rows)
+    assert any(r['stage'] == 'angles' and abs(r['steering']) > 0 for r in rows)
+    reference = summary['cases']['baseline']
+    for tag in ['disabled', 'trace_only']:
+        assert summary['cases'][tag]['memory_sha256'] == reference['memory_sha256'], tag
+        assert summary['cases'][tag]['captures'] == reference['captures'], tag
+    print('disabled / trace-only: byte-identical RAM and captures to baseline with pad steering PASS')
+    assert digest(snapshot) == summary['snapshot_sha256'], 'snapshot changed'
+    (out / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
+
+if __name__ == '__main__':
+    main()
